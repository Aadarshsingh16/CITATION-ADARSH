# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/contract_analyser # gitleaks:allow

# LLM Configuration (OpenAI-compatible / OpenRouter)
# For OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_BASE_URL=
LLM_API_KEY=
# Strong model for final synthesis & verbatim quotes (e.g., anthropic/claude-3.5-sonnet)
LLM_MODEL=
# Fast, economical model for bulk map batches & signal checks (e.g., google/gemini-2.5-flash)
LLM_FAST_MODEL=
LLM_CONTEXT_BUDGET=60000

# Agent Configuration (Part C)
MAX_AGENT_ROUNDS=6
MAX_AGENT_TOOL_CALLS=12
