#!/usr/bin/env bash
# Blocks: staged env files, large files, and likely secrets in added lines.
# Escape hatch for a deliberate false positive: put "gitleaks:allow" on that line.
set -u
fail=0

while IFS= read -r f; do
  [ -z "$f" ] && continue
  base="$(basename "$f")"
  case "$base" in
    .env|.env.*)
      if [ "$base" != ".env.example" ]; then
        echo "BLOCKED: $f is an env file. Only .env.example may be committed."
        fail=1
      fi;;
  esac
  size="$(git cat-file -s ":$f" 2>/dev/null || echo 0)"
  if [ "$size" -gt 5242880 ]; then
    echo "BLOCKED: $f is larger than 5MB. Use .gitignore or a smaller fixture."
    fail=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACM)

added="$(git diff --cached -U0 --no-color | grep -E '^\+' | grep -vE '^\+\+\+' | grep -v 'gitleaks:allow' || true)"

patterns=(
  'sk-[A-Za-z0-9_-]{20,}'
  'AIza[0-9A-Za-z_-]{35}'
  'AKIA[0-9A-Z]{16}'
  'ghp_[A-Za-z0-9]{30,}'
  'xox[baprs]-[A-Za-z0-9-]{10,}'
  '-----BEGIN [A-Z ]*PRIVATE KEY-----'
  '(api[_-]?key|secret|token|password)["'"'"']?[[:space:]]*[:=][[:space:]]*["'"'"'][A-Za-z0-9_./+=-]{16,}["'"'"']'
  '[a-z]+://[^[:space:]/:@]+:[^[:space:]/:@]{4,}@[^[:space:]]+'
)
for p in "${patterns[@]}"; do
  hit="$(printf '%s\n' "$added" | grep -E -m1 -e "$p" || true)"
  if [ -n "$hit" ]; then
    echo "BLOCKED: possible secret in staged changes (pattern: $p)"
    echo "  line: $(printf '%s' "$hit" | cut -c1-80)..."
    fail=1
  fi
done

if [ "$fail" -ne 0 ]; then
  echo
  echo "Commit refused. Remove the secret or file, unstage it, and try again."
  echo "If a real key was already committed earlier, stop and tell the owner so it can be rotated."
  exit 1
fi
exit 0
